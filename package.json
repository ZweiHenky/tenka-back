{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express TypeScript base project",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm db:generate && node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed": "node scripts/development-script.mjs seed",
    "seed:catalogs": "node scripts/development-script.mjs seed-catalogs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:db-safety": "node --test scripts/db-safety.test.mjs",
    "db:generate": "node scripts/prisma-command.mjs generate",
    "db:validate": "node scripts/prisma-command.mjs validate",
    "db:status:dev": "node scripts/prisma-command.mjs status development",
    "db:migrate:dev": "node scripts/prisma-command.mjs migrate-dev development",
    "db:reset:dev": "node scripts/prisma-command.mjs migrate-reset development",
    "db:status:preview": "node scripts/prisma-command.mjs status preview",
    "db:migrate:preview": "node scripts/prisma-command.mjs migrate-deploy preview",
    "db:status:production": "node scripts/prisma-command.mjs status production",
    "db:migrate:production": "node scripts/prisma-command.mjs migrate-deploy production",
    "db:resolve:production": "node scripts/prisma-command.mjs migrate-resolve production",
    "db:script:create-teams": "node scripts/development-script.mjs create-teams",
    "db:script:assign-teams": "node scripts/development-script.mjs assign-teams",
    "db:script:check-teams": "node scripts/development-script.mjs check-teams",
    "db:script:find-division": "node scripts/development-script.mjs find-division",
    "db:script:add-teams": "node scripts/development-script.mjs add-teams",
    "db:script:seed-teams": "node scripts/development-script.mjs seed-teams",
    "sentry:test": "node dist/scripts/test-sentry.js"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.28",
    "@better-auth/prisma-adapter": "^1.6.28",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.68.0",
    "better-auth": "^1.6.28",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "edmonds-blossom": "^1.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "8.6.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/edmonds-blossom": "^1.0.4",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  }
}
