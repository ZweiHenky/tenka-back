  logicalProductIdSnapshot String
  capacityAtStart          Int
  billingIntervalAtStart   BillingInterval
  effectiveStart           DateTime               @db.Timestamptz(3)
  effectiveEnd             DateTime               @db.Timestamptz(3)
  providerStartedAt        DateTime?              @db.Timestamptz(3)
  primaryProviderPeriodId  String
  renewalOfPeriodId        String?
  endedEarlyAt             DateTime?              @db.Timestamptz(3)
  endReason                BillingPeriodEndReason?
  replacedByPeriodId       String?
  providerEndedAt          DateTime?              @db.Timestamptz(3)
  enforcedAt               DateTime?              @db.Timestamptz(3)
  createdAt                DateTime               @default(now())

  billingAccount BillingAccount       @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, map: "billing_periods_account_fkey")
  primaryProviderPeriod BillingProviderPeriod @relation("BillingPeriodPrimaryProvider", fields: [primaryProviderPeriodId], references: [id], onDelete: Restrict, map: "billing_periods_primary_provider_fkey")
  renewalOf BillingPeriod?             @relation("BillingPeriodRenewal", fields: [renewalOfPeriodId], references: [id], onDelete: Restrict, map: "billing_periods_renewal_fkey")
  renewals BillingPeriod[]             @relation("BillingPeriodRenewal")
  replacedBy BillingPeriod?            @relation("BillingPeriodReplacement", fields: [replacedByPeriodId], references: [id], onDelete: Restrict, map: "billing_periods_replacement_fkey")
  replaces BillingPeriod[]             @relation("BillingPeriodReplacement")
  providerSources BillingPeriodSource[]
