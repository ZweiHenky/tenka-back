/// Días y horario que una división juega en UNA cancha concreta.
/// Solo existen filas para canchas configuradas: si no hay fila, esa división no juega ahí.
/// Las ligas de cancha única (multiplesCanchas = false) no usan este modelo y siguen
/// leyendo los escalares de Division. Ver src/utils/divisionSchedule.ts.
model DivisionCanchaHorario {
  id             String   @id @default(cuid())
  diasPartido    String
  horarioPartido String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  divisionId String
  canchaId   String
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  cancha     LigaCancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  @@unique([divisionId, canchaId])
  @@index([canchaId])
  @@map("divisiones_canchas_horarios")
}

