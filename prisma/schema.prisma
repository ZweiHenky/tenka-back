  assignments DivisionCapacityAssignment[]
  convertedFreeGrants FreeManagementGrant[]
  consumedPurchaseSelection BillingPurchaseSelection? @relation("BillingPeriodPurchaseSelection")
  sourceForLocalGrace BillingLocalGrace? @relation("BillingLocalGraceSourcePeriod")
  recoveryForLocalGrace BillingLocalGrace? @relation("BillingLocalGraceRecoveryPeriod")

  @@unique([billingAccountId, materializationKey], map: "billing_periods_account_materialization_key")
  @@index([billingAccountId, effectiveStart, effectiveEnd], map: "billing_periods_account_window_idx")
  @@index([primaryProviderPeriodId], map: "billing_periods_primary_provider_idx")
  @@index([renewalOfPeriodId], map: "billing_periods_renewal_idx")
  @@index([replacedByPeriodId], map: "billing_periods_replacement_idx")
  @@map("billing_periods")
}

