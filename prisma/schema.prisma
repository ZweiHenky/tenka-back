generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRol {
  CAPITAN
  LIGA
  ADMINISTRADOR
}

enum WaitlistRole {
  ORGANIZADOR
  CAPITAN
  AFICIONADO
}

enum TipoPartido {
  REGULAR
  AMISTOSO
  COMPLEMENTO
  ELIMINATORIA
}

enum EstadoPartido {
  PROGRAMADO
  EN_JUEGO
  FINALIZADO
  SUSPENDIDO
}

enum LadoMarcador {
  LOCAL
  VISITANTE
}

enum PosicionJugador {
  PORTERO
  DEFENSA
  LATERAL
  CONTENCION
  MEDIO
  EXTREMO
  DELANTERO
}

enum MediaKind {
  LEAGUE_LOGO
  LEAGUE_COVER
  TEAM_LOGO
  ACCOUNT_AVATAR
  PLAYER_PHOTO
}

enum MediaStatus {
  PENDING
  UPLOADED
  ATTACHED
  ABANDONED
  DEAD
}

enum MediaDeletionStatus {
  PENDING
  LEASED
  DEAD
}

enum NotificationAudience {
  REGISTERED
  FOLLOWERS
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
  CANCELLED
}

enum NotificationEventType {
  JORNADA_GENERATED
  SCHEDULE_CHANGED
}

enum OneSignalTagSyncStatus {
  PENDING
  PROCESSING
  SYNCED
  DEAD
}

enum BillingProviderIdentityKind {
  CANONICAL
  ALIAS
}

enum BillingProviderIdentityStatus {
  ACTIVE
  RETIRED
}

enum FreeManagementGrantSource {
  INITIAL_FREE
  PAID_EXPIRATION
  MIGRATION_SELECTION
  MIGRATION_FALLBACK
  SUPPORT
}

enum FreeManagementGrantEndReason {
  DIVISION_DELETED
  PAID_CONVERSION
  ENTERPRISE_ACTIVATED
  ACCOUNT_DELETED
  ACCOUNT_RECOVERY_REPLACED
  SUPPORT_REPLACED
}

enum BillingStore {
  APPLE
  GOOGLE
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum BillingEnvironment {
  PREVIEW
  PRODUCTION
}

enum BillingOperationalMode {
  ENABLED
  PURCHASES_PAUSED
}

enum BillingStoreEnvironment {
  SANDBOX
  PRODUCTION
}

enum BillingProviderStatus {
  ACTIVE
  BILLING_RETRY
  STORE_GRACE
  ACCOUNT_HOLD
  PAUSED
  EXPIRED
  REVOKED
  UNKNOWN
}

enum BillingProviderEndReason {
  VOLUNTARY
  BILLING_FAILURE
  PAUSE
  REFUND
  REVOCATION
  CHARGEBACK
  FRAUD
  UNKNOWN
}

enum BillingOwnershipType {
  PURCHASED
  FAMILY_SHARED
  UNKNOWN
}

enum BillingTransactionEventType {
  INITIAL_PURCHASE
  RENEWAL
  PRODUCT_CHANGE
  RECOVERY
  UNKNOWN
}

enum BillingCatalogReleaseStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum BillingWebhookEventStatus {
  PENDING
  PROCESSING
  RETRY
  QUARANTINED
  PROCESSED
  DEAD_LETTER
  CONFLICT
}

enum BillingReconciliationJobStatus {
  SCHEDULED
  PROCESSING
  RETRY
}

enum BillingPeriodOrigin {
  STORE
}

enum BillingPeriodEndReason {
  SUPERSEDED
  REFUND
  REVOCATION
  CHARGEBACK
  FRAUD
  PROVIDER_CORRECTION
}

enum BillingLocalGraceStatus {
  ACTIVE
  RECOVERED
  EXPIRED
  TERMINATED
}

enum BillingLocalGraceReason {
  BILLING_FAILURE
}

enum BillingMigrationAccessStatus {
  PREPARED
  SELECTION_REQUIRED
  SELECTED
  PURCHASED
  APPLIED
  REPLACED
}

enum BillingMigrationActivationReviewStatus {
  PENDING_REVIEW
  APPROVED
  BLOCKED
  REJECTED
  INVALIDATED
  COMPLETED
  EXPIRED
}

enum BillingMigrationActivationItemStatus {
  ELIGIBLE
  BLOCKED
  ACTIVATED
}

enum BillingPurchaseSelectionStatus {
  DRAFT
  LOCKED
  APPLIED
  SUPERSEDED
}

enum BillingCheckoutAttemptStatus {
  PREPARED
  STORE_PENDING
  VERIFICATION_PENDING
  CANCEL_REPORTED
  VERIFYING
  VERIFIED
  CANCELED
  REJECTED
  OWNERSHIP_CONFLICT
  ABANDONED
}

enum BillingVerificationStatus {
  PENDING
  VERIFIED
  OWNERSHIP_CONFLICT
  REJECTED
}

enum DivisionCapacityAssignmentSource {
  FREE_CONVERSION
  PURCHASE_SELECTION
  PURCHASE_FALLBACK
  DIRECT
  PERIOD_ROLLOVER
  GRACE_RECOVERY
  RENEWAL_SELECTION
  RENEWAL_FALLBACK
}

enum BillingAuditAction {
  WEBHOOK_QUEUE_VIEWED
  WEBHOOK_EVENT_VIEWED
  WEBHOOK_REPLAY_REQUESTED
  BILLING_PERIOD_MATERIALIZED
  BILLING_PERIOD_SUPERSEDED
  BILLING_PERIOD_ENDED
  BILLING_CAPACITY_GRANTED
  BILLING_DIVISION_ASSIGNED
  BILLING_MATERIALIZATION_BLOCKED
  BILLING_MIGRATION_PREPARED
  BILLING_MIGRATION_ACTIVATED
  BILLING_MIGRATION_FREE_DIVISION_SELECTED
  BILLING_MIGRATION_PURCHASED
  BILLING_MIGRATION_APPLIED
  BILLING_MIGRATION_PAUSE_OPENED
  BILLING_MIGRATION_PAUSE_CLOSED
  BILLING_MIGRATION_SUMMARY_VIEWED
  BILLING_MIGRATION_QUEUE_VIEWED
  BILLING_MIGRATION_DETAIL_VIEWED
  BILLING_MIGRATION_ACTIVATION_REVIEW_CREATED
  BILLING_MIGRATION_ACTIVATION_REVIEW_BLOCKED
  BILLING_MIGRATION_ACTIVATION_REVIEW_VIEWED
  BILLING_MIGRATION_ACTIVATION_REVIEW_APPROVED
  BILLING_MIGRATION_ACTIVATION_REVIEW_REJECTED
  BILLING_MIGRATION_ACTIVATION_REVIEW_EXPIRED
  BILLING_MIGRATION_ACTIVATION_REVIEW_INVALIDATED
  BILLING_MIGRATION_ACTIVATION_ATTEMPT_BLOCKED
  BILLING_MIGRATION_ACTIVATION_REVIEW_COMPLETED
  BILLING_FREE_FOUNDATION_RECONCILED
  BILLING_OPERATIONAL_CONTROL_VIEWED
  BILLING_OPERATIONAL_CONTROL_CHANGED
  BILLING_PURCHASE_SELECTION_CREATED
  BILLING_PURCHASE_SELECTION_UPDATED
  BILLING_PURCHASE_SELECTION_SUPERSEDED
  BILLING_CHECKOUT_ATTEMPT_STARTED
  BILLING_CHECKOUT_OUTCOME_REPORTED
  BILLING_CHECKOUT_ATTEMPT_COMPLETED
  BILLING_VERIFICATION_REQUESTED
  BILLING_VERIFICATION_COMPLETED
  BILLING_LOCAL_GRACE_STARTED
  BILLING_LOCAL_GRACE_RECOVERED
  BILLING_LOCAL_GRACE_EXPIRED
  BILLING_LOCAL_GRACE_TERMINATED
}

enum BillingAuditActorType {
  USER
  SYSTEM
  PROVIDER
}

model User {
  id                      String   @id @default(cuid())
  email                   String   @unique
  emailVerified           Boolean  @default(false)
  name                    String?
  image                   String?
  imagePublicId           String?
  phoneNumber             String?  @unique
  phoneNumberVerified     Boolean  @default(false)
  showPhoneInPublicLeague Boolean  @default(false)
  rol                     UserRol  @default(CAPITAN)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  jugadorId String?  @unique
  jugador   Jugador? @relation("UserJugador")

  accounts                  Account[]
  sessions                  Session[]
  ligas                     Liga[]
  equipos                   Equipo[]
  partidoRefereeAccess      PartidoRefereeAccess[]
  mediaAssets               MediaAsset[]
  notificationSubscriptions DivisionNotificationSubscription[]
  billingAccount            BillingAccount?
  freeManagementGrants      FreeManagementGrant[]
}

model BillingAccount {
  id                  String   @id @default(cuid())
  userId              String?  @unique
  ownerUserIdSnapshot String
  detachedAt          DateTime?
  detachReason        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user               User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerIdentities BillingProviderIdentity[]
  freeGrants         FreeManagementGrant[]
  providerSubscriptionChains BillingProviderSubscriptionChain[]
  billingTransactions BillingTransaction[]
  providerPeriods BillingProviderPeriod[]
  billingPeriods BillingPeriod[]
  periodicReconciliation BillingRevenueCatReconciliation?
  migrationAccess BillingMigrationAccess?
  purchaseSelections BillingPurchaseSelection[]
  checkoutAttempts BillingCheckoutAttempt[]
  billingVerifications BillingVerification[]
  localGraces BillingLocalGrace[]

  @@index([ownerUserIdSnapshot])
  @@map("billing_accounts")
}

model BillingOperationalControl {
  id               String                 @id
  environment      BillingEnvironment     @unique
  mode             BillingOperationalMode @default(PURCHASES_PAUSED)
  reason           String
  changedByAdminId String
  changedAt        DateTime               @db.Timestamptz(3)
  version          Int                    @default(1)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  pauses BillingOperationalPause[]

  @@unique([environment, version], map: "billing_operational_controls_environment_version_key")
  @@map("billing_operational_controls")
}

model BillingMigrationAccess {
  id                             String                       @id
  billingAccountId               String                       @unique
  status                         BillingMigrationAccessStatus @default(PREPARED)
  preparedAt                     DateTime                     @db.Timestamptz(3)
  preparedDivisionCount          Int
  selectedFreeDivisionIdSnapshot String?
  startedAt                      DateTime?                    @db.Timestamptz(3)
  deadline                       DateTime?                    @db.Timestamptz(3)
  activatedAt                    DateTime?                    @db.Timestamptz(3)
  appliedAt                      DateTime?                    @db.Timestamptz(3)
  activationReviewItemId         String?                      @unique
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt

  billingAccount BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, map: "billing_migration_accesses_account_fkey")
  divisions      BillingMigrationDivision[]
  pauseApplications BillingMigrationPauseApplication[]
  sourceFreeGrant FreeManagementGrant?
  activationReviewItems BillingMigrationActivationReviewItem[] @relation("ReviewedMigration")
  activationReviewItem BillingMigrationActivationReviewItem? @relation("ActivatedMigrationReviewItem", fields: [activationReviewItemId], references: [id], onDelete: Restrict, map: "billing_migrations_activation_review_item_fkey")

  @@index([status, preparedAt(sort: Desc), id(sort: Desc)], map: "billing_migration_accesses_status_prepared_id_idx")
  @@map("billing_migration_accesses")
}

model BillingMigrationActivationReview {
  id                         String                                 @id
  environment                BillingEnvironment
  status                     BillingMigrationActivationReviewStatus
  cohortHash                 String
  cohortCount                Int
  reason                     String
  requestedByAdminIdSnapshot String
  approvedByAdminIdSnapshot  String?
  requestedAt                DateTime                               @db.Timestamptz(3)
  approvedAt                 DateTime?                              @db.Timestamptz(3)
  expiresAt                  DateTime                               @db.Timestamptz(3)
  operationalControlVersion  Int
  version                    Int                                    @default(1)
  createdAt                  DateTime                               @default(now())
  updatedAt                  DateTime                               @updatedAt

  items BillingMigrationActivationReviewItem[]

  @@index([status, expiresAt, id], map: "billing_migration_activation_reviews_status_expiry_idx")
  @@index([environment, status, requestedAt(sort: Desc), id(sort: Desc)], map: "billing_migration_reviews_env_status_requested_idx")
  @@map("billing_migration_activation_reviews")
}

model BillingMigrationActivationReviewItem {
  id                String                               @id
  reviewId          String
  billingAccountId  String
  migrationAccessId String?
  stateFingerprint  String
  eligibilityStatus BillingMigrationActivationItemStatus
  blockerCodes      Json
  preparedDivisionCount Int
  liveDivisionCount Int
  activatedAt       DateTime?                            @db.Timestamptz(3)
  createdAt         DateTime                             @default(now())
  updatedAt         DateTime                             @updatedAt

  review BillingMigrationActivationReview @relation(fields: [reviewId], references: [id], onDelete: Restrict, map: "billing_migration_review_items_review_fkey")
  migrationAccess BillingMigrationAccess? @relation("ReviewedMigration", fields: [migrationAccessId], references: [id], onDelete: Restrict, map: "billing_migration_review_items_migration_fkey")
  activatedMigration BillingMigrationAccess? @relation("ActivatedMigrationReviewItem")

  @@unique([reviewId, billingAccountId], map: "billing_migration_review_items_review_account_key")
  @@unique([reviewId, migrationAccessId], map: "billing_migration_review_items_review_migration_key")
  @@index([reviewId, eligibilityStatus, id], map: "billing_migration_review_items_review_status_idx")
  @@index([billingAccountId, reviewId], map: "billing_migration_review_items_account_review_idx")
  @@map("billing_migration_activation_review_items")
}

model BillingOperationalPause {
  id               String             @id
  environment      BillingEnvironment
  startedAt        DateTime           @db.Timestamptz(3)
  endedAt          DateTime?          @db.Timestamptz(3)
  startedByAdminId String
  endedByAdminId   String?
  reason           String
  createdAt        DateTime           @default(now())

  control      BillingOperationalControl          @relation(fields: [environment], references: [environment], onDelete: Restrict, map: "billing_operational_pauses_control_fkey")
  applications BillingMigrationPauseApplication[]

  @@index([environment, startedAt], map: "billing_operational_pauses_environment_started_idx")
  @@map("billing_operational_pauses")
}

model BillingMigrationPauseApplication {
  id                        String   @id
  billingMigrationAccessId  String
  billingOperationalPauseId String
  extensionSeconds          Int
  extensionMilliseconds     BigInt?
  appliedAt                 DateTime @db.Timestamptz(3)
  createdAt                 DateTime @default(now())

  migrationAccess BillingMigrationAccess @relation(fields: [billingMigrationAccessId], references: [id], onDelete: Restrict, map: "billing_migration_pause_applications_access_fkey")
  operationalPause BillingOperationalPause @relation(fields: [billingOperationalPauseId], references: [id], onDelete: Restrict, map: "billing_migration_pause_applications_pause_fkey")

  @@unique([billingMigrationAccessId, billingOperationalPauseId], map: "billing_migration_pause_applications_access_pause_key")
  @@map("billing_migration_pause_applications")
}

model BillingMigrationDivision {
  id                        String   @id
  migrationAccessId         String
  divisionId                String?
  divisionIdSnapshot        String
  divisionCreatedAtSnapshot DateTime
  leagueIdSnapshot          String
  createdAt                 DateTime @default(now())

  migrationAccess BillingMigrationAccess @relation(fields: [migrationAccessId], references: [id], onDelete: Restrict, map: "billing_migration_divisions_access_fkey")
  division        Division?              @relation(fields: [divisionId], references: [id], onDelete: SetNull, map: "billing_migration_divisions_division_fkey")

  @@unique([migrationAccessId, divisionIdSnapshot], map: "billing_migration_divisions_access_snapshot_key")
  @@index([divisionId], map: "billing_migration_divisions_division_idx")
  @@index([migrationAccessId, divisionCreatedAtSnapshot, divisionIdSnapshot], map: "billing_migration_divisions_fallback_idx")
  @@map("billing_migration_divisions")
}

model BillingPurchaseSelection {
  id                   String                         @id @default(cuid())
  billingAccountId     String
  logicalProductId     String
  billingInterval      BillingInterval
  targetCapacity       Int
  status               BillingPurchaseSelectionStatus @default(DRAFT)
  version              Int                            @default(1)
  lockedAt             DateTime?                      @db.Timestamptz(3)
  checkoutAttemptId    String?                        @unique(map: "billing_purchase_selections_checkout_attempt_key")
  consumedByPeriodId   String?                        @unique(map: "billing_purchase_selections_consumed_period_key")
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  billingAccount   BillingAccount                 @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, map: "billing_purchase_selections_account_fkey")
  consumedByPeriod BillingPeriod?                  @relation("BillingPeriodPurchaseSelection", fields: [consumedByPeriodId], references: [id], onDelete: Restrict, map: "billing_purchase_selections_consumed_period_fkey")
  checkoutAttempt  BillingCheckoutAttempt?          @relation("ActiveCheckoutAttempt", fields: [checkoutAttemptId], references: [id], onDelete: Restrict, map: "billing_purchase_selections_checkout_attempt_fkey")
  checkoutAttempts BillingCheckoutAttempt[]         @relation("CheckoutAttemptSelection")
  items            BillingPurchaseSelectionItem[]

  @@index([billingAccountId, status], map: "billing_purchase_selections_account_status_idx")
  @@map("billing_purchase_selections")
}

model BillingCheckoutAttempt {
  id                         String                       @id @default(cuid())
  billingAccountId           String
  purchaseSelectionId        String
  store                      BillingStore
  catalogReleaseIdSnapshot   String
  logicalProductIdSnapshot   String
  billingIntervalSnapshot    BillingInterval
  targetCapacitySnapshot     Int
  offeringIdSnapshot         String
  packageIdSnapshot          String
  storeProductIdSnapshot     String
  basePlanIdSnapshot         String?
  status                     BillingCheckoutAttemptStatus @default(PREPARED)
  version                    Int                          @default(1)
  idempotencyKey             String
  requestFingerprint         String
  startedAt                  DateTime                     @db.Timestamptz(3)
  sdkOutcomeAt               DateTime?                    @db.Timestamptz(3)
  nextVerificationAt         DateTime?                    @db.Timestamptz(3)
  lastVerificationAt         DateTime?                    @db.Timestamptz(3)
  verificationAttempts       Int                          @default(0)
  leaseUntil                 DateTime?                    @db.Timestamptz(3)
  lockedBy                   String?
  terminalAt                 DateTime?                    @db.Timestamptz(3)
  lastErrorCode              String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  billingAccount    BillingAccount             @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, map: "billing_checkout_attempts_account_fkey")
  purchaseSelection BillingPurchaseSelection   @relation("CheckoutAttemptSelection", fields: [purchaseSelectionId], references: [id], onDelete: Restrict, map: "billing_checkout_attempts_selection_fkey")
  activeForSelection BillingPurchaseSelection? @relation("ActiveCheckoutAttempt")
  verification      BillingVerification?

  @@unique([billingAccountId, idempotencyKey], map: "billing_checkout_attempts_account_idempotency_key")
  @@index([status, nextVerificationAt, leaseUntil], map: "billing_checkout_attempts_due_idx")
  @@index([purchaseSelectionId, createdAt], map: "billing_checkout_attempts_selection_created_idx")
  @@map("billing_checkout_attempts")
}

model BillingVerification {
  id                          String                    @id @default(cuid())
  billingAccountId            String
  checkoutAttemptId           String                    @unique(map: "billing_verifications_checkout_attempt_key")
  store                       BillingStore
  idempotencyKey              String
  requestFingerprint          String
  providerSubscriptionChainId String?
  providerTransactionId       String?
  status                      BillingVerificationStatus @default(PENDING)
  requestedAt                 DateTime                  @db.Timestamptz(3)
  lastAttemptAt               DateTime?                 @db.Timestamptz(3)
  verifiedAt                  DateTime?                 @db.Timestamptz(3)
  attemptCount                Int                       @default(0)
  lastErrorCode               String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  billingAccount BillingAccount                   @relation(fields: [billingAccountId], references: [id], onDelete: Restrict, map: "billing_verifications_account_fkey")
  checkoutAttempt BillingCheckoutAttempt           @relation(fields: [checkoutAttemptId], references: [id], onDelete: Restrict, map: "billing_verifications_checkout_attempt_fkey")
  providerSubscriptionChain BillingProviderSubscriptionChain? @relation(fields: [providerSubscriptionChainId], references: [id], onDelete: Restrict, map: "billing_verifications_chain_fkey")

  @@unique([billingAccountId, idempotencyKey], map: "billing_verifications_account_idempotency_key")
  @@index([status, requestedAt], map: "billing_verifications_status_requested_idx")
  @@index([providerSubscriptionChainId], map: "billing_verifications_chain_idx")
  @@map("billing_verifications")
}

model BillingPurchaseSelectionItem {
  id                     String   @id @default(cuid())
  purchaseSelectionId    String
  slotNumber             Int
  divisionIdSnapshot     String
  createdAt              DateTime @default(now())

  purchaseSelection BillingPurchaseSelection @relation(fields: [purchaseSelectionId], references: [id], onDelete: Restrict, map: "billing_purchase_selection_items_selection_fkey")

  @@unique([purchaseSelectionId, slotNumber], map: "billing_purchase_selection_items_selection_slot_key")
  @@unique([purchaseSelectionId, divisionIdSnapshot], map: "billing_purchase_selection_items_selection_division_key")
  @@index([divisionIdSnapshot], map: "billing_purchase_selection_items_division_idx")
  @@map("billing_purchase_selection_items")
}

model BillingProviderIdentity {
  id                       String                        @id @default(cuid())
  billingAccountId         String
  revenueCatAppUserId      String                        @unique
  kind                     BillingProviderIdentityKind
  status                   BillingProviderIdentityStatus @default(ACTIVE)
  observedAsOriginal       Boolean                       @default(false)
  linkedAt                 DateTime                      @default(now())
  retiredAt                DateTime?
  createdAt                DateTime                      @default(now())

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)

  @@index([billingAccountId, status])
  @@map("billing_provider_identities")
}

model FreeManagementGrant {
  id                            String                       @id @default(cuid())
  userId                        String?
  billingAccountId              String?
  divisionId                    String?
  divisionIdSnapshot            String
  divisionNameSnapshot          String
  leagueId                      String?
  leagueIdSnapshot              String
  leagueNameSnapshot            String
  source                        FreeManagementGrantSource
  grantedAt                     DateTime                     @default(now())
  endedAt                       DateTime?
  endReason                     FreeManagementGrantEndReason?
  convertedToBillingPeriodId    String?
  convertedToAssignmentId       String?
  sourceLocalGraceId            String?                      @unique(map: "free_management_grants_source_local_grace_key")
  sourceBillingMigrationAccessId String?                     @unique(map: "free_management_grants_source_migration_key")
  createdAt                     DateTime                     @default(now())

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  billingAccount BillingAccount? @relation(fields: [billingAccountId], references: [id], onDelete: SetNull)
  division       Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  league         Liga?           @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  convertedToBillingPeriod BillingPeriod? @relation(fields: [convertedToBillingPeriodId], references: [id], onDelete: Restrict, map: "free_grants_converted_period_fkey")
  convertedToAssignment DivisionCapacityAssignment? @relation(fields: [convertedToAssignmentId], references: [id], onDelete: Restrict, map: "free_grants_converted_assignment_fkey")
  sourceLocalGrace BillingLocalGrace? @relation(fields: [sourceLocalGraceId], references: [id], onDelete: Restrict, map: "free_management_grants_source_local_grace_fkey")
  sourceBillingMigrationAccess BillingMigrationAccess? @relation(fields: [sourceBillingMigrationAccessId], references: [id], onDelete: Restrict, map: "free_management_grants_source_migration_fkey")

  @@index([userId, endedAt])
  @@index([billingAccountId, endedAt])
  @@index([divisionId])
  @@index([leagueId])
  @@map("free_management_grants")
}

model BillingCatalogRelease {
  id          String                      @id @default(cuid())
  version     String
  environment BillingEnvironment
  status      BillingCatalogReleaseStatus @default(DRAFT)
  approvedAt  DateTime?
  activatedAt DateTime?
  createdAt   DateTime                    @default(now())

  products BillingProductCatalog[]

  @@unique([environment, version])
  @@index([environment, status])
  @@map("billing_catalog_releases")
}

model BillingProductCatalog {
  id                           String          @id @default(cuid())
  catalogReleaseId             String
  logicalProductId             String
  store                        BillingStore
  storeProductId               String
  basePlanId                   String?
  revenueCatOfferingId         String
  revenueCatPackageId          String
  revenueCatProductIdentifier  String
  capacity                     Int
  billingInterval              BillingInterval
  intervalMonths               Int
  active                       Boolean         @default(true)
  createdAt                    DateTime        @default(now())

  catalogRelease BillingCatalogRelease @relation(fields: [catalogReleaseId], references: [id], onDelete: Restrict)

  @@unique([catalogReleaseId, revenueCatOfferingId, revenueCatPackageId, store], map: "billing_product_catalog_offering_package_store_key")
  @@index([catalogReleaseId, store, storeProductId, basePlanId], map: "billing_product_catalog_release_store_product_plan_idx")
  @@index([catalogReleaseId, logicalProductId, billingInterval, store], map: "billing_product_catalog_release_logical_interval_store_idx")
  @@map("billing_product_catalog")
}

model BillingWebhookEvent {
  id                String                    @id @default(cuid())
  providerEventId   String                    @unique
  eventType         String
  payloadRedacted   Json?
  payloadHash       String
  status            BillingWebhookEventStatus @default(PENDING)
