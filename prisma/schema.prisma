generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRol {
  CAPITAN
  LIGA
  ADMINISTRADOR
}

enum TipoPartido {
  REGULAR
  AMISTOSO
  COMPLEMENTO
  ELIMINATORIA
}

enum EstadoPartido {
  PROGRAMADO
  EN_JUEGO
  FINALIZADO
  SUSPENDIDO
}

enum LadoMarcador {
  LOCAL
  VISITANTE
}

enum PosicionJugador {
  PORTERO
  DEFENSA
  LATERAL
  CONTENCION
  MEDIO
  EXTREMO
  DELANTERO
}

enum MediaKind {
  LEAGUE_LOGO
  LEAGUE_COVER
  TEAM_LOGO
  ACCOUNT_AVATAR
  PLAYER_PHOTO
}

enum MediaStatus {
  PENDING
  UPLOADED
  ATTACHED
  ABANDONED
  DEAD
}

enum MediaDeletionStatus {
  PENDING
  LEASED
  DEAD
}

enum NotificationAudience {
  REGISTERED
  FOLLOWERS
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
  CANCELLED
}

enum NotificationEventType {
  JORNADA_GENERATED
  SCHEDULE_CHANGED
}

enum OneSignalTagSyncStatus {
  PENDING
  PROCESSING
  SYNCED
  DEAD
}

model User {
  id                      String   @id @default(cuid())
  email                   String   @unique
  emailVerified           Boolean  @default(false)
  name                    String?
  image                   String?
  imagePublicId           String?
  phoneNumber             String?  @unique
  phoneNumberVerified     Boolean  @default(false)
  showPhoneInPublicLeague Boolean  @default(false)
  rol                     UserRol  @default(CAPITAN)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  jugadorId String?  @unique
  jugador   Jugador? @relation("UserJugador")

  accounts                  Account[]
  sessions                  Session[]
  ligas                     Liga[]
  equipos                   Equipo[]
  partidoRefereeAccess      PartidoRefereeAccess[]
  mediaAssets               MediaAsset[]
  notificationSubscriptions DivisionNotificationSubscription[]
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime?
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
}

model Categoria {
  id     String @id @default(cuid())
  nombre String

  divisiones Division[]

  @@map("categorias")
}

model Tipo {
  id     String @id @default(cuid())
  nombre String

  divisiones Division[]

  @@map("tipos")
}

model Ubicacion {
  id             String @id @default(cuid())
  lat            Float
  lng            Float
  nombreCompleto String
  estado         String
  municipio      String
  timeZone       String

  ligas Liga[]

  @@map("ubicaciones")
}

model EstadoLiga {
  id     String @id @default(cuid())
  nombre String
  /// Identidad estable del estado: BORRADOR | ABIERTA | EN_CURSO | FINALIZADA | CANCELADA.
  /// Toda regla —visibilidad publica y solo lectura— se decide con esto, nunca con el nombre,
  /// que es editable por API: renombrar la fila "Borrador" publicaba todos los borradores.
  codigo String

  divisiones Division[]

  @@index([codigo])
  @@map("estados_liga")
}

model TipoCompetencia {
  id     String @id @default(cuid())
  nombre String
  /// Identidad estable del formato: LIGA_Y_ELIMINATORIAS | ELIMINATORIA. La app decide qué
  /// mostrar con esto, nunca con el nombre, que es editable por API.
  codigo String

  divisiones Division[]

  @@index([codigo])
  @@map("tipos_competencia")
}

model Liga {
  id                String   @id @default(cuid())
  nombre            String
  nombreNormalizado String   @unique
  descripcion       String
  logo              String?
  logoPublicId      String?
  cancha            String?
  canchaPublicId    String?
  multiplesCanchas  Boolean  @default(false)
  usaArbitros       Boolean  @default(false)
  reglas            Json?
  timeZone          String   @default("America/Mexico_City")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ubicacionId String
  userId      String

  ubicacion Ubicacion @relation(fields: [ubicacionId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  divisiones       Division[]
  canchas          LigaCancha[]
  arbitros         LigaArbitro[]
  tandasArbitrales TandaArbitral[]

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ligas")
}

model LigaCancha {
  id                String   @id @default(cuid())
  nombre            String
  nombreNormalizado String
  activa            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ligaId String
  liga   Liga   @relation(fields: [ligaId], references: [id], onDelete: Cascade)

  partidos          Partido[]
  divisionHorarios  DivisionCanchaHorario[]

  @@unique([ligaId, nombreNormalizado])
  @@index([ligaId])
  @@map("ligas_canchas")
}

/// Días y horario que una división juega en UNA cancha concreta.
/// Solo existen filas para canchas configuradas: si no hay fila, esa división no juega ahí.
/// Las ligas de cancha única (multiplesCanchas = false) no usan este modelo y siguen
/// leyendo los escalares de Division. Ver src/utils/divisionSchedule.ts.
model DivisionCanchaHorario {
  id             String   @id @default(cuid())
  diasPartido    String
  horarioPartido String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  divisionId String
  canchaId   String
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  cancha     LigaCancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)

  @@unique([divisionId, canchaId])
  @@index([canchaId])
  @@map("divisiones_canchas_horarios")
}

model LigaArbitro {
  id        String   @id @default(cuid())
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ligaId String
  liga   Liga   @relation(fields: [ligaId], references: [id], onDelete: Cascade)

  partidos PartidoArbitro[]

  @@unique([ligaId, nombre])
  @@index([ligaId])
  @@map("ligas_arbitros")
}

model Division {
  id                       String    @id @default(cuid())
  nombre                   String
  maxEquipos               Int
  arbitraje                Float     @default(0)
  registrarParticipaciones Boolean   @default(false)
  /// Tabla de goleo. Encendido por defecto: existió siempre, y apagarlo por omision se la
  /// quitaria a las divisiones que ya la usan. Apagado congela lo capturado, no lo borra.
  registrarGoleo           Boolean   @default(true)
  usarPenalesEnEmpates     Boolean   @default(true)
  /// Resumen denormalizado (unión) de canchaHorarios, mantenido en la escritura para la vista
  /// pública y los clientes viejos. Es un SUPERCONJUNTO: nunca validar contra estos campos,
  /// usar resolveDivisionSchedule(). Son la fuente real solo en ligas de cancha única.
  diasPartido              String?
  horarioPartido           String?
  duracionPartido          Int?
  descanso                 Int?
  fechaInicio              DateTime?
  fechaFin                 DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  ligaId            String
  estadoLigaId      String
  categoriaId       String
  tipoId            String
  tipoCompetenciaId String

  liga            Liga            @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  estadoLiga      EstadoLiga      @relation(fields: [estadoLigaId], references: [id])
  categoria       Categoria       @relation(fields: [categoriaId], references: [id])
  tipo            Tipo            @relation(fields: [tipoId], references: [id])
  tipoCompetencia TipoCompetencia @relation(fields: [tipoCompetenciaId], references: [id])

  equipos                   DivisionEquipo[]
  jugadores                 DivisionJugador[]
  premios                   Premio[]
  jornadas                  Jornada[]
  rondasPlayoff             RondaPlayoff[]
  tablaPosiciones           TablaPosicion[]
  notificationSubscriptions DivisionNotificationSubscription[]
  notificationOutbox        NotificationOutbox[]
  canchaHorarios            DivisionCanchaHorario[]
  campeones                 DivisionCampeon[]

  @@index([ligaId, createdAt])
  @@map("divisiones")
}

model Equipo {
  id                String  @id @default(cuid())
  nombre            String
  nombreNormalizado String
  logo              String?
  logoPublicId      String?
  userId            String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  divisiones        DivisionEquipo[]
  jugadores         EquipoJugador[]
  divisionJugadores DivisionJugador[]
  partidosLocal     Partido[]              @relation("local")
  partidosVisitante Partido[]              @relation("visitante")
  tablaPosiciones   TablaPosicion[]
  anotaciones       AnotacionPartido[]
  participaciones   ParticipacionPartido[]
  campeonatos       DivisionCampeon[]

  @@unique([userId, nombreNormalizado])
  @@map("equipos")
}

model Jugador {
  id                       String          @id @default(cuid())
  nombre                   String
  posicion                 PosicionJugador
  foto                     String?
  fotoPublicId             String?
  edad                     Int?
  telefono                 String?         @unique
  userId                   String?         @unique
  showPhoneInPublicProfile Boolean         @default(false)
  user                     User?           @relation("UserJugador", fields: [userId], references: [id])
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  equipos         EquipoJugador[]
  divisiones      DivisionJugador[]
  anotaciones     AnotacionPartido[]
  participaciones ParticipacionPartido[]
  titulosGoleo    DivisionCampeon[]

  @@map("jugadores")
}

model EquipoJugador {
  equipoId  String
  jugadorId String
  dorsal    Int
  createdAt DateTime @default(now())

  equipo  Equipo  @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  jugador Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)

  @@id([equipoId, jugadorId])
  @@unique([equipoId, dorsal])
  @@map("equipos_jugadores")
}

model DivisionEquipo {
  divisionId     String
  equipoId       String
  saldoPendiente Decimal @default(0) @db.Decimal(12, 2)

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  equipo   Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  jugadores DivisionJugador[]

  @@id([divisionId, equipoId])
  @@index([equipoId])
  @@map("divisiones_equipos")
}

model DivisionJugador {
  divisionId String
  equipoId   String
  jugadorId  String
  dorsal     Int
  createdAt  DateTime @default(now())

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  equipo   Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  jugador  Jugador  @relation(fields: [jugadorId], references: [id], onDelete: Cascade)

  divisionEquipo DivisionEquipo @relation(fields: [divisionId, equipoId], references: [divisionId, equipoId], onDelete: Cascade)

  @@id([divisionId, equipoId, jugadorId])
  @@index([jugadorId, createdAt])
  @@map("divisiones_jugadores")
}

model Premio {
  id          String   @id @default(cuid())
  posicion    Int
  titulo      String
  monto       Decimal?
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@index([divisionId, posicion])
  @@map("premios")
}

/// Un titulo ganado: quien gano una division y, opcionalmente, quien fue su campeon de goleo.
/// Una division acumula N filas, una por temporada. `archivadoEn` distingue la vigente de las
/// anteriores, y un indice unico parcial garantiza como mucho una vigente por division.
model DivisionCampeon {
  id String @id @default(cuid())

  /// Nulo cuando la division se borro. Los snapshots mantienen el titulo legible: un palmares no
  /// se evapora porque la liga limpie una division vieja.
  divisionId     String?
  division       Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  divisionNombre String
  ligaId         String?
  ligaNombre     String
  ligaLogo       String?

  /// El estado de la division **cuando se corono a este campeon**, no el de ahora. Es lo que decide
  /// si un titulo huerfano —de una division ya borrada— puede verse en publico: una division que
  /// corono campeones estando En Curso y termino su vida en borrador conserva esos titulos.
  divisionEstadoCodigo String

  /// Nulo = campeon vigente de esa division. Con fecha = titulo de una temporada anterior.
  archivadoEn DateTime?

  /// Los ids quedan nulos si el equipo o el jugador se borran despues. Los snapshots
  /// conservan el titulo: un palmares no debe evaporarse con la baja del equipo.
  equipoId     String?
  equipo       Equipo? @relation(fields: [equipoId], references: [id], onDelete: SetNull)
  equipoNombre String
  equipoLogo   String?

  jugadorId     String?
  jugador       Jugador? @relation(fields: [jugadorId], references: [id], onDelete: SetNull)
  jugadorNombre String?
  jugadorFoto   String?
  jugadorGoles  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipoId])
  @@index([jugadorId])
  @@index([divisionId, archivadoEn])
  @@map("divisiones_campeones")
}

model Jornada {
  id                    String    @id @default(cuid())
  numero                Int
  fechaInicio           DateTime? @db.Timestamptz(3)
  fechaFin              DateTime? @db.Timestamptz(3)
  generationKey         String?
  generationRequestHash String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  divisionId         String
  division           Division             @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  partidos           Partido[]
  notificationOutbox NotificationOutbox[]

  @@unique([divisionId, numero])
  @@unique([divisionId, generationKey])
  @@map("jornadas")
}

model RondaPlayoff {
  id        String   @id @default(cuid())
  nombre    String
  orden     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisionId String
  division   Division  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  partidos   Partido[]

  @@unique([divisionId, orden])
  @@map("rondas_playoff")
}

model Partido {
  id                  String         @id @default(cuid())
  golesLocal          Int            @default(0)
  golesVisitante      Int            @default(0)
  penalesLocal        Int?
  penalesVisitante    Int?
  fecha               DateTime?      @db.Timestamptz(3)
  fechaFin            DateTime?      @db.Timestamptz(3)
  estado              EstadoPartido?
  llave               Int?
  tipoPartido         TipoPartido    @default(REGULAR)
  exhibicionLocal     Boolean        @default(false)
  exhibicionVisitante Boolean        @default(false)
  notas               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  version             Int            @default(0)
  manualCreationKey   String?        @unique
  manualCreationHash  String?

  jornadaId         String?
  rondaPlayoffId    String?
  equipoLocalId     String?
  equipoVisitanteId String?
  canchaId          String?

  jornada         Jornada?               @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  rondaPlayoff    RondaPlayoff?          @relation(fields: [rondaPlayoffId], references: [id], onDelete: Cascade)
  equipoLocal     Equipo?                @relation("local", fields: [equipoLocalId], references: [id], onDelete: SetNull)
  equipoVisitante Equipo?                @relation("visitante", fields: [equipoVisitanteId], references: [id], onDelete: SetNull)
  cancha          LigaCancha?            @relation(fields: [canchaId], references: [id], onDelete: SetNull)
  arbitros        PartidoArbitro[]
  tandas          TandaArbitralPartido[]
  refereeAccess   PartidoRefereeAccess[]
  anotaciones     AnotacionPartido[]
  participaciones ParticipacionPartido[]

  @@index([jornadaId])
  @@index([jornadaId, fecha])
  @@index([rondaPlayoffId])
  @@index([rondaPlayoffId, fecha])
  @@index([canchaId])
  @@map("partidos")
}

model AnotacionPartido {
  id                String       @id @default(cuid())
  partidoId         String
  jugadorId         String?
  equipoId          String?
  ladoMarcador      LadoMarcador
  cantidad          Int
  jugadorIdSnapshot String?
  equipoIdSnapshot  String?
  jugadorNombre     String?
  equipoNombre      String?
  dorsal            Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  partido Partido  @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  jugador Jugador? @relation(fields: [jugadorId], references: [id], onDelete: SetNull)
  equipo  Equipo?  @relation(fields: [equipoId], references: [id], onDelete: SetNull)

  @@index([partidoId, ladoMarcador])
  @@index([jugadorId])
  @@index([equipoId])
  @@map("anotaciones_partido")
}

model ParticipacionPartido {
  id                String       @id @default(cuid())
  partidoId         String
  jugadorId         String?
  equipoId          String?
  ladoMarcador      LadoMarcador
  jugadorIdSnapshot String
  equipoIdSnapshot  String
  jugadorNombre     String
  equipoNombre      String
  dorsal            Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  partido Partido  @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  jugador Jugador? @relation(fields: [jugadorId], references: [id], onDelete: SetNull)
  equipo  Equipo?  @relation(fields: [equipoId], references: [id], onDelete: SetNull)

  @@unique([partidoId, jugadorIdSnapshot])
  @@index([partidoId, ladoMarcador])
  @@index([jugadorId])
  @@index([equipoId])
  @@map("participaciones_partido")
}

model PartidoArbitro {
  partidoId String
  arbitroId String
  createdAt DateTime @default(now())

  partido Partido     @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  arbitro LigaArbitro @relation(fields: [arbitroId], references: [id], onDelete: Cascade)

  @@id([partidoId, arbitroId])
  @@index([arbitroId])
  @@map("partidos_arbitros")
}

model TandaArbitral {
  id        String   @id @default(cuid())
  ligaId    String
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  liga     Liga                   @relation(fields: [ligaId], references: [id], onDelete: Cascade)
  partidos TandaArbitralPartido[]

  @@unique([ligaId, nombre])
  @@index([ligaId])
  @@map("tandas_arbitrales")
}

model TandaArbitralPartido {
  tandaId   String
  partidoId String

  tanda   TandaArbitral @relation(fields: [tandaId], references: [id], onDelete: Cascade)
  partido Partido       @relation(fields: [partidoId], references: [id], onDelete: Cascade)

  @@id([tandaId, partidoId])
  @@unique([partidoId])
  @@map("tandas_arbitrales_partidos")
}

model PartidoRefereeAccess {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  partidoId   String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  partido   Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([partidoId])
  @@map("partidos_referee_access")
}

model TablaPosicion {
  id              String @id @default(cuid())
  partidosJugados Int    @default(0)
  ganados         Int    @default(0)
  empatados       Int    @default(0)
  perdidos        Int    @default(0)
  golesFavor      Int    @default(0)
  golesContra     Int    @default(0)
  diferenciaGoles Int    @default(0)
  puntos          Int    @default(0)

  divisionId String
  equipoId   String

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  equipo   Equipo   @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@unique([divisionId, equipoId])
  @@map("tablas_posicion")
}

model MediaDeletionJob {
  id          String              @id @default(cuid())
  publicId    String              @unique
  status      MediaDeletionStatus @default(PENDING)
  leaseUntil  DateTime?
  lockedBy    String?
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(8)
  lastError   String?
  deadAt      DateTime?
  nextTryAt   DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, nextTryAt, leaseUntil])
  @@map("media_deletion_jobs")
}

model MediaAsset {
  id         String      @id @default(cuid())
  ownerId    String
  kind       MediaKind
  publicId   String      @unique
  secureUrl  String?
  format     String?
  bytes      Int?
  width      Int?
  height     Int?
  status     MediaStatus @default(PENDING)
  expiresAt  DateTime
  attachedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([status, expiresAt])
  @@map("media_assets")
}

model DivisionNotificationSubscription {
  id                 String   @id @default(cuid())
  divisionId         String
  oneSignalId        String
  pushSubscriptionId String?
  userId             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([divisionId, pushSubscriptionId])
  @@index([oneSignalId])
  @@index([divisionId, userId])
  @@index([pushSubscriptionId])
  @@map("division_notification_subscriptions")
}

model OneSignalTagCleanupJob {
  id          String                 @id @default(cuid())
  oneSignalId String
  tag         String
  desired     Boolean
  status      OneSignalTagSyncStatus @default(PENDING)
  leaseUntil  DateTime?
  lockedBy    String?
  attempts    Int                    @default(0)
  maxAttempts Int                    @default(8)
  lastError   String?
  deadAt      DateTime?
  nextTryAt   DateTime               @default(now())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([oneSignalId, tag])
  @@index([status, nextTryAt, leaseUntil])
  @@map("onesignal_tag_cleanup_jobs")
}

model NotificationOutbox {
  id                     String                   @id @default(cuid())
  eventKey               String                   @unique
  jornadaId              String?
  divisionId             String
  audience               NotificationAudience
  eventType              NotificationEventType    @default(JORNADA_GENERATED)
  aggregationKey         String?                  @unique
  payload                Json?
  targetUserIds          Json?
  providerIdempotencyKey String                   @unique
  status                 NotificationOutboxStatus @default(PENDING)
  attempts               Int                      @default(0)
  maxAttempts            Int                      @default(8)
  nextAttemptAt          DateTime                 @default(now())
  leaseUntil             DateTime?
  lockedBy               String?
  lastErrorCode          String?
  sentAt                 DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  jornada  Jornada? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, leaseUntil])
  @@index([jornadaId])
  @@index([divisionId, audience])
  @@map("notification_outbox")
}
