# =============================================================================
# PERFIL ACTIVO: LOCAL / TESTING
# =============================================================================
# APP_ENV no acepta "testing". Para desarrollo y pruebas locales usa "local".
# DB_TARGET=development obliga al backend y a Prisma a ignorar DATABASE_URL.
APP_ENV=local
DB_TARGET=development
NODE_ENV=development
PORT=3000

# Local runtime: pooled URL from a dedicated development/testing Neon branch.
# El hostname pooled de Neon contiene "-pooler".
DEV_DATABASE_URL=postgresql://USER:PASSWORD@DEV_ENDPOINT-pooler.REGION.aws.neon.tech/DEV_DATABASE?sslmode=require
# Shared rate-limit store. Use a dedicated local Redis or a managed Redis URL.
REDIS_URL=redis://localhost:6379
# Local migrations: direct URL for the same target as DEV_DATABASE_URL.
# La conexión directa NO contiene "-pooler".
DEV_DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DEV_ENDPOINT.REGION.aws.neon.tech/DEV_DATABASE?sslmode=require
# Integration: may share the non-production database, but only through the isolated schema below.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_ENDPOINT.REGION.aws.neon.tech/TEST_DATABASE?sslmode=require&schema=myleague_integration
# Prisma migrate dev shadow database: direct URL to a separate database/branch.
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@SHADOW_ENDPOINT.REGION.aws.neon.tech/SHADOW_DATABASE?sslmode=require

# =============================================================================
# PERFIL RAILWAY: STAGING
# =============================================================================
# Configura estas variables en Railway > environment staging > backend.
# No las descomentes ni guardes credenciales reales en el .env local.
# Aunque Railway se llame "staging", el valor válido del backend es "preview".
# También debes configurar en Railway las variables comunes de auth, OneSignal y Cloudinary listadas abajo.
#
# APP_ENV=preview
# DB_TARGET=preview
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@STAGING_ENDPOINT-pooler.REGION.aws.neon.tech/STAGING_DATABASE?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@STAGING_REDIS_HOST:PORT
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@STAGING_ENDPOINT.REGION.aws.neon.tech/STAGING_DATABASE?sslmode=require
# BETTER_AUTH_URL=https://API_STAGING_DOMAIN
# PHONE_OTP_MODE=disabled
# SENTRY_DSN=REPLACE_WITH_STAGING_SENTRY_DSN
# CORS_ALLOWED_ORIGINS=https://STAGING_APP_DOMAIN
# NIXPACKS_INSTALL_CMD=pnpm install --frozen-lockfile --prod=false

# =============================================================================
# PERFIL RAILWAY: PRODUCTION
# =============================================================================
# Configura estas variables exclusivamente en Railway > production > backend.
# DATABASE_URL es pooled; DIRECT_DATABASE_URL es directa y no contiene "-pooler".
# PRODUCTION_MIGRATION_TOKEN debe ser aleatorio y nunca guardarse en el repo.
# También debes configurar las variables comunes de auth, OneSignal, Cloudinary y Twilio.
#
# APP_ENV=production
# DB_TARGET=production
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_ENDPOINT-pooler.REGION.aws.neon.tech/PRODUCTION_DATABASE?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@PRODUCTION_REDIS_HOST:PORT
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_ENDPOINT.REGION.aws.neon.tech/PRODUCTION_DATABASE?sslmode=require
# BETTER_AUTH_URL=https://API_PRODUCTION_DOMAIN
# PHONE_OTP_MODE=twilio
# TWILIO_ACCOUNT_SID=REPLACE_WITH_PRODUCTION_TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN=REPLACE_WITH_PRODUCTION_TWILIO_AUTH_TOKEN
# TWILIO_PHONE_NUMBER=+15551234567
# SENTRY_DSN=REPLACE_WITH_PRODUCTION_SENTRY_DSN
# CORS_ALLOWED_ORIGINS=https://PRODUCTION_APP_DOMAIN
# PRODUCTION_MIGRATION_TOKEN=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
# NIXPACKS_INSTALL_CMD=pnpm install --frozen-lockfile --prod=false

# =============================================================================
# VARIABLES COMUNES DEL PERFIL LOCAL ACTIVO
# =============================================================================
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# Server-side key with Google Time Zone API enabled.
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY
# Sign in with Apple (optional; el provider apple se activa solo si están las 4)
APPLE_CLIENT_ID=REPLACE_WITH_APPLE_SERVICES_ID
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
APPLE_KEY_ID=REPLACE_WITH_APPLE_KEY_ID
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_P8_CONTENT\n-----END PRIVATE KEY-----
APPLE_APP_BUNDLE_IDENTIFIER=studio.tenka.app
ONESIGNAL_APP_ID=REPLACE_WITH_ONESIGNAL_APP_ID
ONESIGNAL_REST_API_KEY=REPLACE_WITH_ONESIGNAL_REST_API_KEY
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET
CLOUDINARY_DELIVERY_HOST=res.cloudinary.com
PHONE_OTP_MODE=console
# Twilio (requeridas si PHONE_OTP_MODE=twilio)
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+15551234567
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_RELEASE=
READINESS_TIMEOUT_MS=5000
PROVIDER_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb
GLOBAL_RATE_LIMIT=400
AUTH_RATE_LIMIT=100
OTP_SEND_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
SUBSCRIPTION_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=30
PLAYER_PHONE_LOOKUP_RATE_LIMIT=30
REFEREE_READ_RATE_LIMIT=40
JORNADA_GENERATION_RATE_LIMIT=30
JORNADA_GENERATION_RATE_WINDOW_MINUTES=10
PLAYOFF_GENERATION_RATE_LIMIT=15
PLAYOFF_GENERATION_RATE_WINDOW_MINUTES=15
DESTRUCTIVE_OPERATION_RATE_LIMIT=20
DESTRUCTIVE_OPERATION_RATE_WINDOW_MINUTES=60
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
